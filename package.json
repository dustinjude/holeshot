{
  "name": "holeshot",
  "private": true,
  "type": "module",
  "description": "Jet ski closed-course racing from behind your ski. A static web app that installs to a phone's home screen.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node serve.mjs",
    "sim": "node tools/sim.mjs",
    "test": "node tests/smoke.mjs",
    "model": "node tools/prep-model.mjs",
    "test:city": "node tests/city.mjs",
    "test:season": "node tests/season.mjs",
    "test:talk": "node tests/talk.mjs",
    "test:art": "node tests/art.mjs",
    "test:photo": "node tests/photo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.2",
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@netlify/blobs": "^11.1.12"
  }
}
